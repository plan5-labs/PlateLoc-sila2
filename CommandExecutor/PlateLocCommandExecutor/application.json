{
  "PlateLocCommandExecutor": {
    "Port": "50051",
    "profileName": "test"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "PlateLocCommandExecutor.log",
          "rollOnFileSizeLimit": true
        }
      }
    ]
  }
}