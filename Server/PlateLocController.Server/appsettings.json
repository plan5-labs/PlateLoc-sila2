{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "PlateLocController.Server.log",
          "rollOnFileSizeLimit": true,
          "shared":  true
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "CommandLifetimeInSeconds": 180,
  "EnableTLS": "true", // only for localhost
  "ServerConfig": {
    "Name": "PlateLocController",
    "UUID": "12345678-1234-1234-1234-123456789abc",
    "FQHN": "localhost", //IP or CIDR or Fully Qualified Host Name
    "Port": 5074,
    "NetworkInterface": "0.0.0.0",
    "DiscoveryServiceName": "_sila._tcp",
    "Type": "PlateLocController",
    "Version": "1.0.0",
    "Description": "PlateLoc controll system",
    "VendorURL": "https://plateloc.example.com/"
  },
  "CommandExecutorConfig": {
    "Port": 50051
  }
}
